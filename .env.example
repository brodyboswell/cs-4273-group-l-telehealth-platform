# Copy this file to .env.local and configure Supabase. An LLM provider is optional.
# .env.local is git-ignored — never commit a real API key.
# LLM keys are server-only. The Supabase publishable key is safe for browser use.

# Supabase project Connect dialog. Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# anthropic | openai | mock   (leave empty to auto-pick whichever key is set; no key = mock)
LLM_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where session transcripts are saved (one JSON file per session). Default: ./data/transcripts
TRANSCRIPT_DIR=

# Optional: browser | file. Default is browser on Vercel, file locally.
# Browser mode keeps the active conversation in sessionStorage; saved logs are coming soon.
PRACTICE_STORAGE=
