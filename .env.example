# Copy this file to .env.local and configure Supabase. An LLM provider is optional.
# .env.local is git-ignored — never commit a real API key.
# LLM keys are server-only. The Supabase publishable key is safe for browser use.

# Supabase project Connect dialog. Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# anthropic | openai | mock   (leave empty to auto-pick whichever key is set; no key = mock)
LLM_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where session transcripts are saved (one JSON file per session). Default: ./data/transcripts
TRANSCRIPT_DIR=

# Optional: browser | file. Default is browser on Vercel, file locally.
# Browser mode keeps the active conversation in sessionStorage; saved logs are coming soon.
PRACTICE_STORAGE=

# --- Realtime voice session (see docs/voice-agent.md) -----------------------
# LiveKit Cloud project — https://cloud.livekit.io -> Settings -> API keys.
# LIVEKIT_URL is the wss:// address shown on that same page.
# All three are read only on the server (app/api/livekit-token); the browser
# never sees the API key/secret, only the short-lived token that route mints.
# The voice-agent/ Python worker needs these same three values too.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the voice agent sends to /api/voice/* (it has no user login).
# Any random string of 16+ characters; put the SAME value in voice-agent/.env.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_AGENT_SECRET=
