# Copy this file to .env.local and fill in ONE provider's key.
# .env.local is git-ignored — never commit a real API key.
# Keys are read only on the server (app/api/chat); they are never sent to the browser.

# anthropic | openai | mock   (leave empty to auto-pick whichever key is set; no key = mock)
LLM_PROVIDER=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where session transcripts are saved (one JSON file per session). Default: ./data/transcripts
TRANSCRIPT_DIR=
