# Copy this file to .env (in this voice-agent/ folder) and fill in the real
# values. .env is git-ignored — never commit a real key or secret.
#
# These are the SAME LiveKit Cloud project values used by the Next.js app's
# .env.local (LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET) — copy them
# from there once you've created the project. See docs/voice-agent.md.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same Anthropic key the text chat already uses (console.anthropic.com).
# Copy the value from the main app's .env.local — don't create a second key
# just for this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Where the Next.js app is running, so this agent can GET /api/persona from
# it and read/write the same transcript files. Default is correct for local
# development (npm run dev on the default port).
NEXTJS_BASE_URL=http://localhost:3000

# Only set this if TRANSCRIPT_DIR was customized in the main app's
# .env.local too — it must point at the exact same folder on disk so both
# processes read/write the same transcript files. Leave empty otherwise.
TRANSCRIPT_DIR=
